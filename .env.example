# ===========================================================================
# MEMAR — environment configuration EXAMPLE
# ===========================================================================
# Copy this file to `.env` (which is git-ignored) and fill in real values:
#
#     cp .env.example .env
#     # edit .env, then validate:
#     cd backend && ../.venv/bin/python scripts/preflight.py
#
# All variables the app reads are MEMAR_* and listed below, grouped by
# subsystem. Each is tagged:
#
#   [REQUIRED-PROD]  must be set for a real production launch (MEMAR_ENV=production)
#   [CONDITIONAL]    required only if its subsystem is enabled (e.g. Stripe)
#   [OPTIONAL]       safe default exists; set to override or enable a feature
#
# Defaults shown in comments are the code's fallback when the var is unset.
# ===========================================================================


# ---------------------------------------------------------------------------
# CORE / DEPLOYMENT
# ---------------------------------------------------------------------------

# [REQUIRED-PROD] Deployment mode. Set to "production" to enforce production
# behavior (notably: MEMAR_JWT_SECRET becomes mandatory and the app refuses to
# boot without it). Anything else (incl. unset) is treated as dev/test.
MEMAR_ENV=production

# [REQUIRED-PROD] Public-facing base URL of this deployment. Used for Stripe
# checkout success/cancel redirects and links inside outbound emails.
# Default if unset: http://localhost:9000 (billing) / https://memar.app (email)
# — both wrong in production.
MEMAR_PUBLIC_URL=https://memar.example.com

# [OPTIONAL] SQLite database path. Default: ./memar.db
MEMAR_DB_PATH=/var/lib/memar/memar.db

# [OPTIONAL] Writable data directory (floor plans, generated admin creds, etc).
# Default: ./data
MEMAR_DATA_DIR=/var/lib/memar/data

# [OPTIONAL] Explicit path to the devices config file. Default: auto-discovered.
# MEMAR_CONFIG_PATH=/etc/memar/devices.yaml

# [OPTIONAL] Comma-separated allowed CORS origins.
# Default: http://localhost:5173,http://localhost:8080,http://localhost:3000
MEMAR_CORS_ORIGINS=https://memar.example.com

# [OPTIONAL] Demo mode (seeds fake devices/data). Leave unset in production.
# MEMAR_DEMO_MODE=false


# ---------------------------------------------------------------------------
# AUTH
# ---------------------------------------------------------------------------

# [REQUIRED-PROD] Secret used to sign JWT access tokens. The app REFUSES to
# boot in production if this is unset. Use >= 32 chars / 64 hex chars:
#     python -c "import secrets; print(secrets.token_hex(32))"
# A random per-process key (the dev fallback) invalidates all sessions on
# restart and causes random 401s across multiple workers.
MEMAR_JWT_SECRET=

# Initial admin account. Leave MEMAR_ADMIN_PASSWORD blank to boot with the
# default login admin / admin — the app then FORCES a password change on first
# login before anything is reachable. Or set a password here to skip the default
# entirely (no forced change). Either way, never run with admin/admin unchanged.
MEMAR_ADMIN_USER=admin
MEMAR_ADMIN_PASSWORD=

# [OPTIONAL] Disables auth entirely when "1"/"true"/"yes". DEV ONLY — never set
# this in production.
# MEMAR_NO_AUTH=false


# ---------------------------------------------------------------------------
# LICENSING (Ed25519)
# ---------------------------------------------------------------------------
# Keys are base64-encoded 32-byte Ed25519 keys.
# Generate a fresh pair with:
#     cd backend && ../.venv/bin/python scripts/generate_license_keypair.py

# [CONDITIONAL — ISSUER INSTANCE ONLY] Private signing key. Set this ONLY on the
# single instance that receives Stripe webhooks and issues license keys. NEVER
# put it on customer/self-hosted deployments. NEVER commit it. If it leaks,
# anyone can forge valid licenses.
# MEMAR_LICENSE_PRIVATE_KEY=

# [OPTIONAL] Public verification key. Overrides the key embedded in
# license.py. Set on instances that must verify licenses, or leave unset to use
# the embedded default.
# MEMAR_LICENSE_PUBLIC_KEY=

# [OPTIONAL] A signed license key for THIS instance's tier (the
# base64(sig+payload) blob produced by the issuer). Unset = free tier.
# MEMAR_LICENSE_KEY=


# ---------------------------------------------------------------------------
# STRIPE / BILLING
# ---------------------------------------------------------------------------
# This whole subsystem is CONDITIONAL: if MEMAR_STRIPE_SECRET_KEY is unset,
# billing/checkout is simply disabled (valid for self-hosted-without-billing).
# If it IS set, the webhook secret and all price IDs become required, and any
# price ID left as a "price_placeholder…" value will cause checkout to 500.

# [CONDITIONAL] Stripe API secret key. Use a live key (sk_live_…) in production.
# MEMAR_STRIPE_SECRET_KEY=<your-stripe-secret-key>

# [CONDITIONAL] Stripe webhook signing secret (whsec_…). Required when Stripe is
# enabled; webhooks fail signature verification without it.
# MEMAR_STRIPE_WEBHOOK_SECRET=<your-webhook-signing-secret>

# [CONDITIONAL] Price IDs per tier. Get these from the Stripe Dashboard. Monthly:
# MEMAR_STRIPE_PRICE_MAKER=price_xxxxxxxxxxxx
# MEMAR_STRIPE_PRICE_PRO=price_xxxxxxxxxxxx
# MEMAR_STRIPE_PRICE_FARM=price_xxxxxxxxxxxx
# MEMAR_STRIPE_PRICE_SCALE=price_xxxxxxxxxxxx
# Annual variants:
# MEMAR_STRIPE_PRICE_MAKER_ANNUAL=price_xxxxxxxxxxxx
# MEMAR_STRIPE_PRICE_PRO_ANNUAL=price_xxxxxxxxxxxx
# MEMAR_STRIPE_PRICE_FARM_ANNUAL=price_xxxxxxxxxxxx
# MEMAR_STRIPE_PRICE_SCALE_ANNUAL=price_xxxxxxxxxxxx
# Professional / B2B tiers:
# MEMAR_STRIPE_PRICE_WORKSHOP=price_xxxxxxxxxxxx
# MEMAR_STRIPE_PRICE_BUSINESS=price_xxxxxxxxxxxx
# MEMAR_STRIPE_PRICE_ENTERPRISE=price_xxxxxxxxxxxx
# Air-gap perpetual licenses (one-time, no subscription):
# MEMAR_STRIPE_PRICE_AIRGAP_STANDARD=price_xxxxxxxxxxxx
# MEMAR_STRIPE_PRICE_AIRGAP_ENTERPRISE=price_xxxxxxxxxxxx


# ---------------------------------------------------------------------------
# EMAIL / SMTP
# ---------------------------------------------------------------------------
# CONDITIONAL: only needed if you want outbound email (license delivery,
# payment-failed notices, scheduled reports). If none is set, email no-ops.

# [OPTIONAL] Recipient for owner notifications and issued-license copies.
# MEMAR_OWNER_EMAIL=owner@example.com

# [OPTIONAL] Comma-separated list of recipients for operational alert emails
# (device offline, coolant warnings, payment failures). Unset = alerts skipped.
# MEMAR_ALERT_EMAILS=ops@example.com,on-call@example.com

# [OPTIONAL] SMTP server. Default host: smtp.gmail.com, default port: 587.
# MEMAR_SMTP_HOST=smtp.gmail.com
# MEMAR_SMTP_PORT=587
# MEMAR_SMTP_USER=mailer@example.com
# MEMAR_SMTP_FROM=MEMAR <mailer@example.com>

# MEMAR_SMTP_PASSWORD=app-password-here


# ---------------------------------------------------------------------------
# OPTIONAL INTEGRATIONS / TUNING
# ---------------------------------------------------------------------------

# [OPTIONAL] Slack incoming webhook for alerts. Unset = Slack alerts disabled.
# MEMAR_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# [OPTIONAL] Coolant subsystem webhook URL. Unset = coolant alerts disabled.
# MEMAR_COOLANT_WEBHOOK_URL=https://hooks.example.com/coolant

# [OPTIONAL] Print-monitor poll interval (seconds). Default: code default.
# MEMAR_MONITOR_INTERVAL=30

# [OPTIONAL] Vision model name for print CV. Default: vision
# MEMAR_VISION_MODEL=vision

# [OPTIONAL] LLM endpoint for vision-based print-failure detection.
# Must expose an OpenAI-compatible /v1/chat/completions endpoint.
# MEMAR_VISION_LLM_URL=http://localhost:11434/v1

# [OPTIONAL] Filament cost used in OEE / cost reporting. Default: 25.0 (USD/kg).
# MEMAR_FILAMENT_COST_PER_KG=25.0

# [OPTIONAL] Path to the print-CV binary. Default: auto-detect.
# MEMAR_PRINT_CV_BIN=/usr/local/bin/print-cv

# [OPTIONAL] Path to the spool-CV (Rust) binary. Default: built path under
# tools/spool-cv/target/release/spool-cv.
# MEMAR_SPOOL_CV_BIN=/usr/local/bin/spool-cv

# NOTE: there is also a non-prefixed WEBHOOK_URL read in one module
# (webhooks.py). It is outside the MEMAR_* namespace and intentionally not
# listed here — set it directly in the environment if that path is used.


# ---------------------------------------------------------------------------
# UNIFIED MESSAGING HUB
# ---------------------------------------------------------------------------
# All adapters are OPTIONAL and self-gate — configure only the platforms you
# want. None configured = hub runs in no-op mode (existing HTTP webhooks still
# fire via the Webhooks event bus above).
#
# After configuring, link your platform user IDs to MEMAR accounts:
#   POST /api/admin/messaging/identities
#   {"platform": "telegram", "platform_user_id": "123456789", "username": "admin"}
# Then test with:
#   POST /api/admin/messaging/test

# --- Telegram ---
# [OPTIONAL] Bot token from @BotFather. Enables polling (no public URL needed).
# MEMAR_TELEGRAM_BOT_TOKEN=
# [OPTIONAL] Comma-separated chat IDs for broadcast alerts.
# MEMAR_TELEGRAM_CHAT_ID=
# [OPTIONAL] Bootstrap: these Telegram user IDs are auto-linked as admin on first
# start (before you can use the admin API to link). Format: "123456789,987654321"
# MEMAR_TELEGRAM_BOOTSTRAP_ADMIN_IDS=

# --- ntfy ---
# [OPTIONAL] ntfy.sh topic URL (push-only). Works with self-hosted ntfy too.
# MEMAR_NTFY_URL=https://ntfy.sh/your-topic
# MEMAR_NTFY_TOKEN=                     # optional auth token
# MEMAR_NTFY_PRIORITY=default           # min/low/default/high/urgent

# --- Generic Webhook (replaces MEMAR_COOLANT_WEBHOOK_URL) ---
# [OPTIONAL] HTTP POST endpoint for all alert events. Covers Zapier, Make,
# PagerDuty, OpsGenie, HomeAssistant, n8n, and any custom HTTP endpoint.
# MEMAR_NOTIFY_WEBHOOK_URL=https://hooks.example.com/memar
# MEMAR_NOTIFY_WEBHOOK_TEMPLATE=        # path to Jinja2 .json template (optional)
# MEMAR_NOTIFY_WEBHOOK_SECRET=          # HMAC-SHA256 signing secret
# MEMAR_NOTIFY_WEBHOOK_HEADERS=         # JSON string, e.g. '{"Authorization":"Bearer xyz"}'
# MEMAR_NOTIFY_WEBHOOK_EVENTS=          # comma-sep filter, e.g. "printer.error,cnc.coolant_low"

# --- Slack ---
# [OPTIONAL] Keep existing webhook URL for outbound-only mode.
# MEMAR_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# [OPTIONAL] Add bot token + app token for Socket Mode (bidirectional commands).
# MEMAR_SLACK_BOT_TOKEN=xoxb-
# MEMAR_SLACK_APP_TOKEN=xapp-
# MEMAR_SLACK_CHANNEL_ID=C0XXXXXXXXX

# --- Discord ---
# [OPTIONAL] Channel webhook URL (push-only).
# MEMAR_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXX/YYY
# [OPTIONAL] Bot token (bidirectional — requires discord.py>=2.0 in requirements).
# MEMAR_DISCORD_BOT_TOKEN=
# MEMAR_DISCORD_CHANNEL_ID=

# --- Mattermost ---
# [OPTIONAL] Mattermost server + bot token for bidirectional.
# MEMAR_MATTERMOST_URL=https://chat.example.com
# MEMAR_MATTERMOST_BOT_TOKEN=
# MEMAR_MATTERMOST_CHANNEL_ID=
# MEMAR_MATTERMOST_WEBHOOK_URL=         # alternative push-only path
# MEMAR_MATTERMOST_COMMAND_TOKEN=       # required for inbound /api/messaging/mattermost/command — must match the "Token" shown when you create the slash command in Mattermost. Requests without a matching token are rejected (403).

# --- Matrix/Element ---
# [OPTIONAL] Matrix homeserver + bot credentials for bidirectional.
# MEMAR_MATRIX_HOMESERVER=https://matrix.org
# MEMAR_MATRIX_USER=@memar-bot:matrix.org
# MEMAR_MATRIX_PASSWORD=
# MEMAR_MATRIX_ROOM_ID=!roomid:matrix.org


# ---------------------------------------------------------------------------
# LICENSE HEARTBEAT (OPTIONAL — auto-renewal for SaaS subscribers)
# ---------------------------------------------------------------------------
# When set, MEMAR polls this URL hourly to refresh its license key from Stripe.
# Subscription customers get seamless renewals without manual key paste.
# Air-gap and perpetual licenses ignore this entirely (no phone-home).
# Unset = heartbeat disabled (default; correct for most self-hosted installs).
# MEMAR_LICENSE_HEARTBEAT_URL=https://license.example.com/heartbeat


# ---------------------------------------------------------------------------
# SSO — OIDC (OpenID Connect)
# ---------------------------------------------------------------------------
# CONDITIONAL: all four vars required to enable OIDC SSO. Unset = OIDC disabled.
# MEMAR_OIDC_ISSUER=https://accounts.google.com
# MEMAR_OIDC_CLIENT_ID=1234567890-abcdefg.apps.googleusercontent.com
# MEMAR_OIDC_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxx
# MEMAR_OIDC_REDIRECT_URI=https://memar.example.com/auth/oidc/callback

# [OPTIONAL] Default role assigned to new SSO users. Default: viewer.
# MEMAR_SSO_DEFAULT_ROLE=viewer


# ---------------------------------------------------------------------------
# SSO — LDAP / Active Directory
# ---------------------------------------------------------------------------
# CONDITIONAL: MEMAR_LDAP_SERVER required to enable LDAP auth.
# MEMAR_LDAP_SERVER=ldap://dc.example.com:389
# MEMAR_LDAP_USER_DN_TEMPLATE=cn={username},ou=users,dc=example,dc=com

# [OPTIONAL] Default role assigned to LDAP-authenticated users. Default: viewer.
# MEMAR_LDAP_DEFAULT_ROLE=viewer
