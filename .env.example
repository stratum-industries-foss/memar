# ===========================================================================
# MEMAR — optional settings (.env.example)
# ===========================================================================
# NOTHING IS REQUIRED TO START MEMAR. Every line below is optional and commented
# out. Leave this file alone and run:  docker compose up -d
# MEMAR creates its own secrets, database and first-admin setup link on start.
#
# Copy to .env only when you want to change a setting:
#     cp .env.example .env
#
# Docker: leave the storage paths alone. The image and compose file put all state
# in the memar-data volume (/app/data). Change the host port with MEMAR_HOST_PORT.
#
# Tags: [CONDITIONAL] only matters if its feature is enabled. [OPTIONAL] has a
# safe default.
# ===========================================================================


# ---------------------------------------------------------------------------
# DOCKER HOST SETTINGS (read by docker compose, not by MEMAR)
# ---------------------------------------------------------------------------
# [OPTIONAL] Host port that maps to MEMAR's port 8000. Default: 8000.
# MEMAR_HOST_PORT=8000

# [OPTIONAL] Only with docker-compose.host-network.yml (Linux): MEMAR listens on
# this port directly on the host. Default: 8000. The standard compose file ignores it.
# MEMAR_PORT=8000


# ---------------------------------------------------------------------------
# CORE
# ---------------------------------------------------------------------------
# [OPTIONAL] Public base URL, used for Stripe redirects and links in email.
# Default: the setup link is built from the server's LAN address.
# MEMAR_PUBLIC_URL=https://memar.example.com

# [OPTIONAL] Allowed CORS origins, comma-separated. Default: local dev origins.
# MEMAR_CORS_ORIGINS=https://memar.example.com

# [OPTIONAL] Demo mode (seeds fake devices). Leave unset in production.
# MEMAR_DEMO_MODE=false


# ---------------------------------------------------------------------------
# AUTH AND SETUP
# ---------------------------------------------------------------------------
# [OPTIONAL] Your own JWT signing secret (64+ hex characters). If unset, MEMAR
# generates one and keeps it in its data volume (jwt-secret).
# MEMAR_JWT_SECRET=

# [OPTIONAL] Create the admin account from the environment instead of the setup
# link. If set, the instance is never "unclaimed". Leave unset to use the setup link.
# MEMAR_ADMIN_USER=admin
# MEMAR_ADMIN_PASSWORD=

# [OPTIONAL] First-account policy: auto (default), open, or code.
#   auto: the first visitor may claim without a code for 10 minutes after each start.
#   open: the first visitor may always claim without a code.
#   code: a setup code is always required.
# MEMAR_SETUP_MODE=auto
# MEMAR_SETUP_WINDOW_MIN=10

# [OPTIONAL] Disables authentication entirely. DEV ONLY. Never set in production.
# MEMAR_NO_AUTH=false


# ---------------------------------------------------------------------------
# LICENSING
# ---------------------------------------------------------------------------
# [OPTIONAL] Signed license key for this instance's tier. Unset = free tier.
# Installer alternative: bash install.sh --license KEY  (or --license-file PATH).
# An air-gap licence makes the setup code mandatory on first claim.
# MEMAR_LICENSE_KEY=

# [OPTIONAL] Public verification key. Default: the key embedded in the release.
# MEMAR_LICENSE_PUBLIC_KEY=

# The license signing (private) key is issuer-only. It is never set on a customer
# or self-hosted instance, so it is not listed here.

# [OPTIONAL] Auto-renewal endpoint for subscription customers. Unset = disabled.
# MEMAR_LICENSE_HEARTBEAT_URL=https://license.example.com/heartbeat


# ---------------------------------------------------------------------------
# STRIPE / BILLING [CONDITIONAL: all of these together enable billing]
# ---------------------------------------------------------------------------
# MEMAR_STRIPE_SECRET_KEY=sk_live_...
# MEMAR_STRIPE_WEBHOOK_SECRET=whsec_...
# MEMAR_STRIPE_PRICE_MAKER=price_...
# MEMAR_STRIPE_PRICE_PRO=price_...
# MEMAR_STRIPE_PRICE_FARM=price_...
# MEMAR_STRIPE_PRICE_SCALE=price_...
# MEMAR_STRIPE_PRICE_MAKER_ANNUAL=price_...
# MEMAR_STRIPE_PRICE_PRO_ANNUAL=price_...
# MEMAR_STRIPE_PRICE_FARM_ANNUAL=price_...
# MEMAR_STRIPE_PRICE_SCALE_ANNUAL=price_...
# MEMAR_STRIPE_PRICE_WORKSHOP=price_...
# MEMAR_STRIPE_PRICE_BUSINESS=price_...
# MEMAR_STRIPE_PRICE_ENTERPRISE=price_...
# MEMAR_STRIPE_PRICE_AIRGAP_STANDARD=price_...
# MEMAR_STRIPE_PRICE_AIRGAP_ENTERPRISE=price_...


# ---------------------------------------------------------------------------
# EMAIL [OPTIONAL: without SMTP, email is skipped]
# ---------------------------------------------------------------------------
# MEMAR_OWNER_EMAIL=owner@example.com
# MEMAR_ALERT_EMAILS=ops@example.com,on-call@example.com
# MEMAR_SMTP_HOST=smtp.gmail.com
# MEMAR_SMTP_PORT=587
# MEMAR_SMTP_USER=mailer@example.com
# MEMAR_SMTP_PASSWORD=
# MEMAR_SMTP_FROM=MEMAR <mailer@example.com>


# ---------------------------------------------------------------------------
# ALERTS AND INTEGRATIONS [OPTIONAL: each is off until set]
# ---------------------------------------------------------------------------
# Generic webhook (Zapier, Make, PagerDuty, Home Assistant, n8n, any HTTP endpoint):
# MEMAR_NOTIFY_WEBHOOK_URL=https://hooks.example.com/memar
# MEMAR_NOTIFY_WEBHOOK_SECRET=
# MEMAR_NOTIFY_WEBHOOK_HEADERS=
# MEMAR_NOTIFY_WEBHOOK_EVENTS=printer.error,cnc.coolant_low

# ntfy:
# MEMAR_NTFY_URL=https://ntfy.sh/your-topic
# MEMAR_NTFY_TOKEN=
# MEMAR_NTFY_PRIORITY=default

# Slack:
# MEMAR_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# MEMAR_SLACK_BOT_TOKEN=xoxb-
# MEMAR_SLACK_APP_TOKEN=xapp-
# MEMAR_SLACK_CHANNEL_ID=C0XXXXXXXXX

# Discord:
# MEMAR_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXX/YYY
# MEMAR_DISCORD_BOT_TOKEN=
# MEMAR_DISCORD_CHANNEL_ID=

# Telegram:
# MEMAR_TELEGRAM_BOT_TOKEN=
# MEMAR_TELEGRAM_CHAT_ID=
# MEMAR_TELEGRAM_BOOTSTRAP_ADMIN_IDS=

# Mattermost:
# MEMAR_MATTERMOST_URL=https://chat.example.com
# MEMAR_MATTERMOST_BOT_TOKEN=
# MEMAR_MATTERMOST_CHANNEL_ID=
# MEMAR_MATTERMOST_COMMAND_TOKEN=

# Matrix:
# MEMAR_MATRIX_HOMESERVER=https://matrix.org
# MEMAR_MATRIX_USER=@memar-bot:matrix.org
# MEMAR_MATRIX_PASSWORD=
# MEMAR_MATRIX_ROOM_ID=!roomid:matrix.org

# Coolant alert webhook:
# MEMAR_COOLANT_WEBHOOK_URL=https://hooks.example.com/coolant


# ---------------------------------------------------------------------------
# SSO [OPTIONAL: OIDC needs all four ISSUER/CLIENT/SECRET/REDIRECT values]
# ---------------------------------------------------------------------------
# MEMAR_OIDC_ISSUER=https://accounts.google.com
# MEMAR_OIDC_CLIENT_ID=
# MEMAR_OIDC_CLIENT_SECRET=
# MEMAR_OIDC_REDIRECT_URI=https://memar.example.com/auth/oidc/callback
# MEMAR_SSO_DEFAULT_ROLE=viewer

# LDAP / Active Directory:
# MEMAR_LDAP_SERVER=ldap://dc.example.com:389
# MEMAR_LDAP_USER_DN_TEMPLATE=cn={username},ou=users,dc=example,dc=com
# MEMAR_LDAP_DEFAULT_ROLE=viewer


# ---------------------------------------------------------------------------
# TUNING [OPTIONAL]
# ---------------------------------------------------------------------------
# MEMAR_MONITOR_INTERVAL=30          # print-monitor poll interval, seconds
# MEMAR_FILAMENT_COST_PER_KG=25.0    # used in OEE and cost reports
# MEMAR_VISION_MODEL=vision          # print-CV model name
# MEMAR_VISION_LLM_URL=http://localhost:11434/v1   # OpenAI-compatible endpoint

# Allow devices on public addresses in the connection test (hosted MEMAR, port forwards).
# MEMAR_ALLOW_PUBLIC_DEVICES=false

# Docker only: run as this host user/group so files in a host folder are owned by it (NAS).
# MEMAR_UID=10001
# MEMAR_GID=10001
